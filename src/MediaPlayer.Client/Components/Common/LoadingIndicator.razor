@*
    Centered Bootstrap spinner used in place of plain "Loading..." text
    while a page or modal fetches its data. Inverse mode flips the colors
    for use on the dark kiosk display.
*@

<div class="@WrapperClass">
    <div class="spinner-border @SpinnerColorClass" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
    @if (!string.IsNullOrEmpty(Message))
    {
        <div class="mt-3 @TextColorClass">@Message</div>
    }
</div>

@code {
    [Parameter] public string? Message { get; set; } = "Loading...";

    /// <summary>When true, render light-on-dark for use on the kiosk display.</summary>
    [Parameter] public bool Inverse { get; set; }

    /// <summary>If false, the wrapper does not stretch to fill the parent height.</summary>
    [Parameter] public bool FillHeight { get; set; } = true;

    private string WrapperClass =>
        FillHeight
            ? "d-flex flex-column align-items-center justify-content-center h-100 py-5"
            : "d-flex flex-column align-items-center justify-content-center py-5";

    private string SpinnerColorClass => Inverse ? "text-light" : "text-primary";
    private string TextColorClass => Inverse ? "text-white-50" : "text-muted";
}

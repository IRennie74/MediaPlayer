@*
    Dark navy top app bar — brand on the left, action chips on the right.
    Mirrors the layout of the user-supplied reference screenshot.
*@

@inject IAuthGate AuthGate
@inject NavigationManager Nav

<Bar Background="Background.Primary"
     ThemeContrast="ThemeContrast.Dark"
     Mode="BarMode.Horizontal"
     Breakpoint="Breakpoint.Desktop">
    <BarBrand>
        <BarItem>
            <BarLink To="/admin">
                <BarIcon IconName="IconName.Tv" />
                <strong class="ms-1">MediaPlayer</strong>
            </BarLink>
        </BarItem>
    </BarBrand>
    <BarMenu>
        <BarStart></BarStart>
        <BarEnd>
            <BarItem>
                <BarLink Clicked="OpenDisplayInNewTab" Title="Open kiosk display">
                    <BarIcon IconName="IconName.Desktop" />
                </BarLink>
            </BarItem>
            <BarItem>
                <BarLink Title="Notifications (placeholder)">
                    <BarIcon IconName="IconName.Bell" />
                </BarLink>
            </BarItem>
            <BarItem>
                <BarDropdown>
                    <BarDropdownToggle>
                        <BarIcon IconName="IconName.User" />
                        <span class="ms-1">Admin</span>
                    </BarDropdownToggle>
                    <BarDropdownMenu>
                        <BarDropdownItem Clicked="LogoutAsync">
                            <Icon Name="IconName.Unlock" /> Sign Out
                        </BarDropdownItem>
                    </BarDropdownMenu>
                </BarDropdown>
            </BarItem>
        </BarEnd>
    </BarMenu>
</Bar>

@code {
    private void OpenDisplayInNewTab()
        => Nav.NavigateTo("/", forceLoad: true);

    private async Task LogoutAsync()
    {
        await AuthGate.LogoutAsync();
        Nav.NavigateTo("/admin/login");
    }
}

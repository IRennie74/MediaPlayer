@*
    Static accordion-style sidebar — group headings stay visible, items are
    direct nav-links underneath (no click-to-expand dropdowns). The active
    route gets a solid blue background via Bootstrap's list-group `active`
    state. Search filters items in place.
*@

<aside class="bg-white border-end flex-shrink-0" style="width: 260px;">
    <div class="p-3 border-bottom">
        <div class="input-group input-group-sm">
            <span class="input-group-text bg-white border-end-0 text-muted">
                <Icon Name="IconName.Search" />
            </span>
            <input class="form-control border-start-0 ps-0"
                   placeholder="Search menu..."
                   value="@searchTerm"
                   @oninput="HandleSearch" />
        </div>
    </div>

    <nav class="py-1">
        @foreach (var group in VisibleGroups)
        {
            <div class="px-3 pt-3 pb-1 small fw-semibold text-uppercase text-muted">
                <Icon Name="@group.Icon" Margin="Margin.Is2.FromEnd" />@group.Label
            </div>
            <div class="list-group list-group-flush">
                @foreach (var item in group.VisibleItems)
                {
                    <NavLink @key="item.Route"
                             href="@item.Route"
                             Match="@(item.Route == "/admin" ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                             class="list-group-item list-group-item-action border-0 d-flex align-items-center px-4 py-2 text-decoration-none"
                             ActiveClass="active">
                        <Icon Name="@item.Icon" Margin="Margin.Is2.FromEnd" />
                        @item.Label
                    </NavLink>
                }
            </div>
        }
        @if (!VisibleGroups.Any())
        {
            <div class="text-muted small px-3 py-3">No menu items match.</div>
        }
    </nav>
</aside>

@code {
    private string searchTerm = string.Empty;

    private void HandleSearch(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
    }

    private record MenuItem(string Label, string Route, IconName Icon);
    private sealed record MenuGroup(string Label, IconName Icon, IReadOnlyList<MenuItem> Items)
    {
        public IEnumerable<MenuItem> VisibleItems => Items;
    }

    private static readonly IReadOnlyList<MenuGroup> AllGroups = new MenuGroup[]
    {
        new("Overview", IconName.Dashboard, new MenuItem[]
        {
            new("Dashboard", "/admin", IconName.Dashboard),
        }),
        new("Content", IconName.Image, new MenuItem[]
        {
            new("Playlists", "/admin/playlists", IconName.List),
            new("Media Library", "/admin/media", IconName.Images),
        }),
        new("Operations", IconName.Building, new MenuItem[]
        {
            new("Locations", "/admin/locations", IconName.MapMarkerAlt),
            new("Kiosks", "/admin/kiosks", IconName.Tv),
        }),
    };

    private IEnumerable<MenuGroup> VisibleGroups
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchTerm))
            {
                return AllGroups;
            }
            return AllGroups
                .Select(g => g with
                {
                    Items = g.Items
                        .Where(i => i.Label.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                        .ToArray()
                })
                .Where(g => g.Items.Count > 0)
                .ToArray();
        }
    }
}
